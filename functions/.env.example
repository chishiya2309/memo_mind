# Server only credentials. Never pass provider API keys to Flutter.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=8080

# FR18 server-side configuration. Mobile clients never receive these credentials.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_REGION=ap-southeast-1
S3_BACKUP_BUCKET=
# On AWS, attach the least-privilege IAM role instead of using access keys.
# Outside AWS, configure the standard SDK credential chain in the server environment.
