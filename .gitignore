# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.tmp
*.bak
# Microsoft Office lock files; keep actual project documents.
~$*
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local environment and service-account credentials
.env
.env.*
!.env.example
**/serviceAccountKey.json
**/serviceAccount*.json
**/*service-account*.json
# Includes firebase-admin.json and downloaded PROJECT-firebase-adminsdk-*.json.
**/*firebase-admin*.json
**/client_secret*.json
/secrets/
/functions/secrets/
.aws/

# Private signing keys and certificates, wherever they are stored.
key.properties
*.keystore
*.jks
*.pem
*.key
*.p12
*.pfx
# Intentionally shared development key; never use it for production.
!/android/keystore/team-debug.keystore
# Firebase Android client configuration is shared, not an Admin private key.
!/android/app/google-services.json

# Node.js / Backend functions
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase CLI
.firebase/
firebase-debug.log*
firebase-debug.*.log*
firestore-debug.log*
ui-debug.log*
**/functions/.runtimeconfig.json

# Local Android & Build outputs
android/local.properties
*.apk
*.aab
config/*.local.json

# JVM crash dumps (crash/replay text logs are already covered by *.log).
*.hprof
*.dmp

